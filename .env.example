# ── Mercado Livre (app OVERWINE — usar o secret NOVO, pós-rotação) ──
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_USER_ID=
ML_REDIRECT_URI=https://igororlandi999.github.io/overwine-dashboard/

# ── Segurança do backend ──
# Chave só sua, usada apenas para semear o token (POST /api/auth/seed)
ADMIN_KEY=
# Substitui a antiga VIEWER_PASSWORD (escolha uma senha NOVA — a antiga é pública)
DASHBOARD_PASSWORD=
# Origem autorizada para CORS (o dashboard no GitHub Pages)
ALLOWED_ORIGIN=https://igororlandi999.github.io

# ── Upstash Redis (cache + rotação do refresh token + rate limit) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Notificações do Mercado Livre (pedidos em tempo real) ──
# Segredo exigido na URL de callback registrada no painel do ML:
#   https://<backend>/api/notifications/ml?k=<ML_WEBHOOK_SECRET>
# Mínimo de 16 caracteres. OPCIONAL: sem ele o endpoint responde 503 e o
# backend segue atualizando os pedidos só pela reconciliação de hora em hora.
# O ML não assina as notificações (sem HMAC, sem header, sem lista de IPs) —
# o segredo na URL é o único mecanismo disponível, então a URL registrada no
# painel é uma credencial.
ML_WEBHOOK_SECRET=

# ── Multi-conta (etapas 0 e 1) ──
# Desligada (padrão), só a conta legada overwine-ml é aceita nas rotas.
# MULTI_CONTA_ENABLED=false
# Contas do registro (src/config/contas.json) ATIVADAS neste ambiente, por id,
# separadas por vírgula. É o interruptor de produção da Degustar: sem ela
# aqui, a conta existe só no registro e toda rota responde 400 conta_inativa.
# CONTAS_ATIVAS=degustar-ml
# user_id do Mercado Livre da Degustar (obrigatório quando degustar-ml estiver ativa)
# ML_DEGUSTAR_USER_ID=

# ── Auto-refresh do dashboard (todas opcionais, com default) ──
# Idade (s) do último check a partir da qual uma aba aberta pede sincronização.
# ORDERS_REFRESH_IDADE_MAX_S=25
# Cooldown global (s): N abas abertas produzem uma sincronização.
# ORDERS_REFRESH_COOLDOWN_S=15
# Intervalo (s) entre revisões profundas (passo incremental de 5 páginas).
# ORDERS_REFRESH_REVISAO_S=600
# Cooldown (s) imposto após um 429 do Mercado Livre.
# ORDERS_REFRESH_COOLDOWN_429_S=120
